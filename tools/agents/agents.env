# tools/agents/agents.env —— sbs-local 项目级参数（覆盖机器级 ~/.agent-parallel/tools/agents.env）
# 模板与字段说明见 agents.env.example；本文件被 gitignore。

# 新 worktree 的基准分支（集成主干）
BASE_BRANCH=main-local

# 开一个 worktree 的磁盘预估（GB）：build/ 实测 ~5.6G + 源码树与余量
DISK_RESERVE_GB=8

# 临时目录前缀（+ AGENT_INDEX）
TMP_ROOT_PREFIX=/tmp/sbs_ws_

# 无头派发的完成标准：构建+全量场景回归+registry dump 一体的全量门
#（gate.sh 自带全局构建锁 → tools/night/build.sh；本仓库没有独立 TEST_CMD——
#  场景回归就在门里，孤儿二进制清理/registry dump 也一并跑）
BUILD_CMD=tools/agents/gate.sh
TEST_CMD=tools/agents/gate.sh

# 资源命名（本项目无 per-worktree 库，此字段仅让分配记录不带上游邮件项目默认前缀）
DB_NAME_PREFIX=sbs_ws_
