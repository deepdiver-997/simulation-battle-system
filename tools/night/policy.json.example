#!/bin/bash
# 夜跑策略档（用户可改；agent 只读）—— build/night/policy.json
#
# 作用：把"何时停、停多久、谁能跑"从代码常量变成用户可随时改的数据档。
# agent 只读本档并遵守之；用户随时改 → 下一次 should_stop/claim 判定立即生效
# （脚本每次调用都重新读盘，无需重启会话）。
#
# 字段：
#   mode            "run"（全速跑）｜"stop"（全员停）｜"window"（只在窗口内跑）
#                   另有 stop_at 字段供 "window" 模式用。
#   stop_at         HHMM 窗口模式下的停止时刻（默认 0825 = 保留晨间缓冲）
#   window_start    HHMM 窗口模式下的起始时刻（默认 0000）
#   allow_overtime  true = 允许越过 stop_at 继续跑（限时免费模型期间用；
#                   false = 到点即停）
#   note            给 agent 看的一句话说明（会话启动时念一遍）
#   updated_at      用户最后一次修改时间（agent 只读，用于识别"用户刚改过"）
#
# 例：限时免费模型期间，把 mode 改 "window" + allow_overtime true + window_start 0000
#     → 夜跑不再在 08:25 自动停，可以一直跑到额度用完。

{
  "mode": "run",
  "window_start": "0000",
  "stop_at": "0825",
  "allow_overtime": false,
  "note": "默认策略：不受窗口限制地跑；用户可改本档即时生效。",
  "updated_at": "2026-10-13"
}
