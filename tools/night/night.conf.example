# 复制为 night.conf 后生效（同目录，KEY=VALUE）。全部可省，默认值见 lib.sh。
# 夜跑参数调这里，不用改脚本。

# 构建在飞上限（12核/16GB 建议 2；构建排队在脚本内阻塞，会话数可以多于槽数）
# SLOTS=2

# 每个构建槽的并行度（默认 = 核数/SLOTS）
# JOBS=6

# 停止窗口（HHMM）：此后不再领新任务、滞留中的会话陆续退出，给 09:00 额度起点留缓冲
# STOP_AT=0825

# 队列空时会话脚本内部滞留秒数（期间零 API 消耗；到点醒来再看一眼队列）
# WAIT_TIMEOUT=1800

# 场景编号段：每任务独占 SCENARIO_BLOCK 个号，从 SCENARIO_BASE 起全局顺延（模板要求 170 起）
# SCENARIO_BASE=170
# SCENARIO_BLOCK=10
